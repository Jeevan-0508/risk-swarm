{
  "name": "risk-swarm",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "RISK//SWARM - a multi-agent risk investigation system where AI agents disagree before humans decide",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc -b --noEmit",
    "snapshot:check": "node scripts/sync-snapshots.mjs --check",
    "snapshot:sync": "node scripts/sync-snapshots.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
